{
    "name": "@browsercore/transport",
    "version": "0.2.4",
    "description": "Generic byte-stream transport abstraction (TCP sockets, DNS, backpressure). No knowledge of TLS or HTTP.",
    "repository": {
        "type": "git",
        "url": "https://github.com/jverneuer/browsercore-transport.git"
    },
    "homepage": "https://github.com/jverneuer/browsercore-transport#readme",
    "bugs": {
        "url": "https://github.com/jverneuer/browsercore-transport/issues"
    },
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "bin",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc -p tsconfig.json",
        "prepublishOnly": "npm run clean && npm run build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "lint": "oxlint --type-aware src/",
        "docs": "typedoc"
    },
    "dependencies": {
        "@browsercore/contracts": "0.2.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "7.0.2001",
        "typedoc": "^0.28.20",
        "typedoc-plugin-llms-txt": "^0.1.2",
        "typedoc-plugin-markdown": "^4.12.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=26.0.0"
    }
}
